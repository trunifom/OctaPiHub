# Umgebungsdatei für den Dienst: /etc/octapihub/octapihub.env (Rechte 0600, Besitzer octapihub).
# Das Zugriffs-Token schützt alle Änderungen in der Weboberfläche. Mit z. B.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ein langes, zufälliges Token erzeugen und unten eintragen.
OCTAPIHUB_WEB_TOKEN=HIER-EIN-LANGES-ZUFAELLIGES-TOKEN-EINTRAGEN

# Nur dieses Gerät (Standard). Für den Zugriff im Heimnetz die LAN-Adresse des Geräts
# eintragen, z. B. 192.168.1.50. Keine Ports im Router freigeben.
# OCTAPIHUB_HOST=127.0.0.1
# OCTAPIHUB_PORT=8080
